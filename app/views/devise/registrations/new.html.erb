<div class="auth-wrapper">
  <div class="auth-card">
    <div class="mb-6 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Validation Points</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Crie a sua conta</p>
    </div>
    
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :name, "Nome", class: "form-label" %>
        <%= f.text_field :name, autofocus: true, placeholder: "Seu Nome", class: "form-input" %>
      </div>
      
      <div>
        <%= f.label :email, "E-mail", class: "form-label" %>
        <%= f.email_field :email, autocomplete: "email", placeholder: "seu@email.com", class: "form-input" %>
      </div>

      <div class="field">
        <%= f.label :password, "Senha", class: "form-label" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-1"><em>(<%= @minimum_password_length %> caracteres mínimos)</em></p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "form-input" %>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, "Confirme a senha", class: "form-label" %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %></p>
      </div>

      <div class="pt-2">
        <%= f.submit "Cadastrar", class: "btn-primary" %>
      </div>
    <% end %>
    
    <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-800 text-center space-y-2 text-xs">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
