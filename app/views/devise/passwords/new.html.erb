<div class="auth-wrapper">
  <div class="auth-card">
    <div class="mb-6 text-center">
      <h2 class="text-2xl font-bold tracking-tight">Recuperar Senha</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Informe seu e-mail para enviarmos as instruções de redefinição</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "E-mail cadastrado", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "form-input" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Enviar link de recuperação", class: "btn-primary cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 pt-4 border-t border-gray-200 dark:border-gray-800 text-center space-y-2 text-xs">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
