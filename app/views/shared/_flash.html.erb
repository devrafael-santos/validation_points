<% if notice.present? %>
  <div data-controller="notification"
       data-notification-delay-value="4000"
       data-transition-enter-from="opacity-0 -translate-y-4"
       data-transition-enter-to="opacity-100 translate-y-0"
       data-transition-leave-from="opacity-100 translate-y-0"
       data-transition-leave-to="opacity-0 -translate-y-4"
       class="flash-toast flash-notice">
    <span><%= notice %></span>
    <button type="button" data-action="notification#hide" class="cursor-pointer opacity-70 hover:opacity-100">
      ✕
    </button>
  </div>
<% end %>

<% if alert.present? %>
  <div data-controller="notification"
       data-notification-delay-value="4000"
       data-transition-enter-from="opacity-0 -translate-y-4"
       data-transition-enter-to="opacity-100 translate-y-0"
       data-transition-leave-from="opacity-100 translate-y-0"
       data-transition-leave-to="opacity-0 -translate-y-4"
       class="flash-toast flash-alert">
    <span><%= alert %></span>
    <button type="button" data-action="notification#hide" class="cursor-pointer opacity-70 hover:opacity-100">
      ✕
    </button>
  </div>
<% end %>