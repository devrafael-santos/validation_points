<div data-menu-target="content" class="hidden fixed inset-0 z-50 md:hidden">
  <div data-action="click->menu#toggle" class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity"></div>

  <div class="fixed inset-y-0 right-0 w-full max-w-xs bg-white dark:bg-gray-900 border-l border-gray-200 dark:border-gray-800 shadow-2xl p-6 flex flex-col justify-between z-10">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-gray-200 dark:border-gray-800 mb-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Navegação</span>
        <button type="button" data-action="click->menu#toggle" class="btn-action cursor-pointer p-1.5" aria-label="Fechar menu">
          <svg class="w-5 h-5 text-gray-700 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <% if user_signed_in? %>
        <div class="bg-gray-50 dark:bg-gray-800/60 border border-gray-200 dark:border-gray-800 rounded-2xl p-4 mb-6 flex items-center gap-3">
          <%= user_avatar(current_user, size_class: "w-12 h-12 text-base") %>
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-bold text-gray-900 dark:text-white truncate"><%= current_user.name %></h4>
            <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= current_user.email %></p>
            <span class="inline-block mt-1 px-2 py-0.5 text-[10px] font-semibold rounded-full <%= current_user.admin? ? 'bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800' : 'bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300' %>">
              <%= current_user.role.capitalize %>
            </span>
          </div>
        </div>
      <% end %>

      <nav class="space-y-2">
        <%= link_to new_task_path, data: { turbo_frame: "drawer", action: "click->menu#toggle" }, class: "btn-primary w-full py-3 px-3.5 text-sm font-semibold justify-start gap-3 shadow-xs" do %>
          <svg class="w-5 h-5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Nova Tarefa</span>
        <% end %>

        <%= link_to root_path, class: "flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800/60 transition-colors" do %>
          <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Quadro Kanban</span>
        <% end %>

        <% if policy(:dashboard).show? %>
          <%= link_to admin_root_path, class: "flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800/60 transition-colors" do %>
            <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Painel Admin</span>
          <% end %>
        <% end %>
      </nav>
    </div>

    <div class="pt-4 border-t border-gray-200 dark:border-gray-800 space-y-4">
      <div class="flex items-center justify-between px-2">
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Alternar Tema</span>
        <%= render "shared/theme_toggle" %>
      </div>

      <% if user_signed_in? %>
        <%= button_to destroy_user_session_path, method: :delete, form_class: "w-full", class: "btn-action-danger w-full justify-center py-2.5 text-xs font-semibold cursor-pointer" do %>
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Encerrar Sessão</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>