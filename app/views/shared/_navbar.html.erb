<header data-controller="menu" class="shrink-0 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-6 py-3 sticky top-0 z-40 transition-colors duration-200">
  <div class="w-full flex items-center justify-between gap-4">
    <div class="flex items-center gap-6">
      <%= link_to root_path, class: "flex items-center gap-2 group" do %>
        <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-xs group-hover:bg-indigo-700 transition-colors">
          VP
        </div>
        <span class="text-base font-bold text-gray-900 dark:text-white tracking-tight hidden sm:inline-block">
          Validation Points
        </span>
      <% end %>

      <nav class="hidden md:flex items-center gap-1">
        <%= link_to "Kanban", root_path, class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{current_page?(root_path) ? 'bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors'}" %>

        <% if policy(:dashboard).show? %>
          <%= link_to "Painel Admin", admin_root_path, class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{current_page?(admin_root_path) ? 'bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors'}" %>
        <% end %>

        <% if policy(:user).index? %>
          <%= link_to "Usuários", admin_users_path, class: "px-3 py-1.5 rounded-lg text-xs font-semibold #{request.path.start_with?(admin_users_path) ? 'bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors'}" %>
        <% end %>
      </nav>
    </div>

    <div class="hidden md:flex items-center gap-3">
      <%= link_to "+ Nova Tarefa", new_task_path, data: { turbo_frame: "drawer" }, class: "btn-primary cursor-pointer text-xs w-auto py-1.5 px-3" %>

      <div class="flex items-center gap-2 pl-3 border-l border-gray-200 dark:border-gray-800">
        <%= user_avatar(current_user, size_class: "w-7 h-7 text-xs") %>
        <span class="text-xs font-medium text-gray-700 dark:text-gray-300">
          <%= current_user.name %>
        </span>
        <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "btn-action-danger cursor-pointer text-xs py-1 px-2" %>
      </div>

      <div class="pl-2">
        <%= render "shared/theme_toggle" %>
      </div>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <%= link_to "+", new_task_path, data: { turbo_frame: "drawer" }, class: "btn-primary w-8 h-8 rounded-lg p-0 text-base font-bold flex items-center justify-center" %>

      <button type="button" data-action="click->menu#toggle" class="btn-action cursor-pointer p-1.5" aria-label="Abrir menu">
        <svg class="w-5 h-5 text-gray-700 dark:text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <%= render "shared/mobile_menu" %>
</header>