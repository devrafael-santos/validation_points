<div class="w-full min-h-screen flex flex-col px-6 pt-6 pb-8 max-w-5xl mx-auto">
  <div class="flex items-center justify-between pb-6 border-b border-color mb-8">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-main tracking-tight">Perfil de Usuário</h1>
      <p class="text-xs md:text-sm text-muted mt-1">
        Informações da conta e atividades de revisão.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to "← Voltar ao Kanban", root_path, class: "btn-action cursor-pointer text-xs sm:text-sm py-2 px-3" %>
      <% if @user == current_user %>
        <%= link_to "Editar Meus Dados", edit_user_registration_path, class: "btn-primary cursor-pointer text-xs sm:text-sm w-auto py-2 px-3.5" %>
      <% end %>
    </div>
  </div>

  <div class="bg-surface border border-color rounded-2xl p-6 sm:p-8 mb-8 shadow-xs flex flex-col sm:flex-row items-center sm:items-start gap-6">
    <%= user_avatar(@user, size_class: "w-20 h-20 text-2xl ring-4 ring-indigo-500/20") %>

    <div class="flex-1 text-center sm:text-left min-w-0">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-1">
        <h2 class="text-xl font-bold text-main truncate"><%= @user.name %></h2>
        <span class="inline-flex items-center justify-center self-center sm:self-auto px-2.5 py-0.5 rounded-full text-xs font-semibold <%= @user.admin? ? 'bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700' %>">
          <%= @user.role.capitalize %>
        </span>
      </div>

      <p class="text-sm text-muted mb-4"><%= @user.email %></p>

      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-page border border-color text-xs text-muted">
        <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span><strong><%= @active_reviews_count %></strong> tarefas em revisão ativa</span>
      </div>
    </div>
  </div>

  <div class="bg-surface border border-color rounded-2xl p-6 sm:p-8 shadow-xs">
    <div class="flex items-center justify-between pb-4 border-b border-color mb-6">
      <div>
        <h3 class="text-base font-bold text-main">Tarefas Sob Revisão</h3>
        <p class="text-xs text-muted mt-0.5">Fila de tarefas atribuídas a este revisor.</p>
      </div>
      <span class="badge badge-accent"><%= @reviewing_tasks.count %> total</span>
    </div>

    <% if @reviewing_tasks.any? %>
      <div class="space-y-3">
        <% @reviewing_tasks.each do |task| %>
          <div class="bg-page border border-color rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-indigo-500/40 dark:hover:border-indigo-400/40 transition-colors shadow-xs">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                <span class="text-xs font-mono font-bold text-muted">[<%= task.jira_key %>]</span>
                <span class="badge <%= priority_badge_class(task.priority) %>">
                  <%= task.priority.capitalize %>
                </span>
                <span class="text-xs text-muted">• <%= task.epic.name %></span>
              </div>
              <h4 class="text-sm font-semibold text-main truncate"><%= task.title %></h4>
            </div>

            <div class="flex items-center gap-2.5 shrink-0 self-start sm:self-center">
              <span class="text-xs font-medium px-2.5 py-1 rounded-lg bg-surface border border-color text-muted">
                <%= task.stage.humanize %>
              </span>

              <% if task.jira_url.present? %>
                <%= link_to "Jira ↗", task.jira_url, target: "_blank", rel: "noopener", class: "btn-action text-xs py-1 px-2.5" %>
              <% end %>

              <% if task.pull_request_url.present? %>
                <%= link_to "PR ↗", task.pull_request_url, target: "_blank", rel: "noopener", class: "btn-action-pr text-xs py-1 px-2.5" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-12 text-center text-muted">
        <svg class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-sm font-medium">Nenhuma tarefa atribuída a este revisor no momento.</p>
      </div>
    <% end %>
  </div>
</div>
