<div class="w-full max-w-6xl mx-auto py-8 px-4">
  <header class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-gray-200 dark:border-gray-800 gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">Internal Review Queue</h1>
        <% if @total_count > 0%>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-500/20">
          <%= @total_count %> tasks
        </span>
        <% end %>
        <% if @urgent_count > 0 %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-500/20 animate-pulse">
            <%= @urgent_count %> urgentes
          </span>
        <% end %>
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
        Fila de validação técnica interna antes de avançar para Code Review geral.
      </p>
    </div>

    <div class="flex items-center gap-4">
      <div data-controller="theme">
        <button type="button" 
                data-action="click->theme#toggle"
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 text-xs font-medium transition cursor-pointer shadow-xs"
                title="Alternar entre modo claro e escuro">
          <span data-theme-target="iconDark" class="hidden flex items-center gap-1.5">
            <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <span>Tema Claro</span>
          </span>
          <span data-theme-target="iconLight" class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
            <span>Tema Escuro</span>
          </span>
        </button>
      </div>
    </div>
  </header>

  <div class="flex items-center gap-2 my-6 overflow-x-auto pb-2">
    <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mr-2">Filtrar:</span>
    <%= link_to "Todos", root_path,
        class: "px-3 py-1.5 rounded-lg text-xs font-medium transition border #{params[:project_type].blank? ? 'bg-indigo-600 text-white border-transparent shadow-xs' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700'}" %>
    
    <% Epic.project_types.each do |key, value| %>
      <%= link_to key.titleize, root_path(project_type: value),
          class: "px-3 py-1.5 rounded-lg text-xs font-medium transition border #{params[:project_type].to_s == value.to_s ? 'bg-indigo-600 text-white border-transparent shadow-xs' : 'bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-700'}" %>
    <% end %>
  </div>

  <% if @tasks.empty? %>
    <div class="text-center py-16 bg-white dark:bg-gray-900/50 rounded-xl border border-gray-200 dark:border-gray-800 shadow-xs">
      <p class="text-gray-500 dark:text-gray-400">🎉 Nenhuma tarefa em Internal Review no momento!</p>
    </div>
  <% else %>
    <div class="grid gap-4">
      <% @tasks.each do |task| %>
        <article class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 hover:border-gray-300 dark:hover:border-gray-700 rounded-xl p-5 transition shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-gray-700">
                <%= task.epic.name %>
              </span>

              <% type_colors = {
                "backend" => "bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-200 dark:border-emerald-500/20",
                "frontend" => "bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 border-sky-200 dark:border-sky-500/20",
                "mobile" => "bg-purple-50 dark:bg-purple-500/10 text-purple-700 dark:text-purple-400 border-purple-200 dark:border-purple-500/20",
                "fullstack" => "bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-200 dark:border-amber-500/20"
              } %>
              <span class="px-2 py-0.5 rounded text-xs font-medium border <%= type_colors[task.epic.project_type] %>">
                <%= task.epic.project_type.upcase %>
              </span>

              <% priority_colors = {
                "urgent" => "bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border-red-200 dark:border-red-500/30 font-semibold",
                "high" => "bg-orange-50 dark:bg-orange-500/10 text-orange-700 dark:text-orange-400 border-orange-200 dark:border-orange-500/30",
                "medium" => "bg-yellow-50 dark:bg-yellow-500/10 text-yellow-700 dark:text-yellow-400 border-yellow-200 dark:border-yellow-500/30",
                "low" => "bg-gray-100 dark:bg-gray-500/10 text-gray-700 dark:text-gray-400 border-gray-200 dark:border-gray-500/30"
              } %>
              <span class="px-2 py-0.5 rounded text-xs border <%= priority_colors[task.priority] %>">
                <%= task.priority.capitalize %>
              </span>

              <% if task.story_points.present? %>
                <span class="text-xs text-gray-500 dark:text-gray-400 font-mono">
                  <%= task.story_points %> pts
                </span>
              <% end %>
            </div>

            <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition">
              <%= task.title %>
            </h2>

            <% if task.description.present? %>
              <p class="text-xs text-gray-600 dark:text-gray-400 line-clamp-2">
                <%= task.description %>
              </p>
            <% end %>
          </div>

          <div class="flex items-center gap-3 pt-3 md:pt-0 border-t md:border-t-0 border-gray-200 dark:border-gray-800">
            <% if task.jira_url.present? %>
              <%= link_to task.jira_url, target: "_blank", rel: "noopener",
                  class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 transition border border-gray-300 dark:border-gray-700" do %>
                <span>Jira</span>
                <span class="font-mono text-gray-500 dark:text-gray-400">(<%= task.jira_key %>)</span>
                ↗
              <% end %>
            <% end %>

            <% if task.pull_request_url.present? %>
              <%= link_to task.pull_request_url, target: "_blank", rel: "noopener",
                  class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-indigo-50 dark:bg-indigo-600/20 hover:bg-indigo-100 dark:hover:bg-indigo-600/30 text-indigo-700 dark:text-indigo-300 transition border border-indigo-200 dark:border-indigo-500/30" do %>
                <span>Ver PR</span>
                ↗
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>