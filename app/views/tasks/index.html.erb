<%= turbo_stream_from "tasks" %>
<div class="w-full min-h-screen flex flex-col px-6 pt-6 pb-2">

  <header class="shrink-0 flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-gray-200 dark:border-gray-800 gap-4">
    <div>

      <div class="flex items-center gap-3">

        <h1 class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight">Validation Points Board</h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-200 dark:border-blue-500/20">
          <%= @total_count %> tasks
        </span>
        <% if @urgent_count > 0 %>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-500/20 animate-pulse">
            <%= @urgent_count %> urgentes
          </span>
        <% end %>
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
        Gerenciamento do fluxo de tarefas e fila de Internal Review.
      </p>
    </div>
    <div class="flex items-center gap-4">
      <%= link_to "+ Nova Tarefa", new_task_path, data: { turbo_frame: "drawer" }, class: "btn-primary cursor-pointer text-sm" %>
      <% if user_signed_in? %>

        <div class="flex items-center gap-3 pl-3 border-l border-gray-200 dark:border-gray-800">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">
            <% if current_user.avatar.attached? %>
              <%= image_tag current_user.avatar, class: "w-8 h-8 rounded-full object-cover" %>
            <% else %>
              <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold text-xs">
                <%= current_user.name.first.upcase %>
              </div>
            <% end %>
            Olá, <strong><%= current_user.name %></strong>
          </span>
          <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "btn-action cursor-pointer text-red-600 dark:text-red-400" %>
        </div>
      <% end %>
      <div data-controller="theme" class="flex items-center gap-2">
        <span class="text-xs font-medium text-gray-500 dark:text-gray-400 select-none">
          🌙
        </span>

        <button type="button"
                data-action="click->theme#toggle"
          class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-gray-300 dark:bg-indigo-600 transition-colors duration-200 ease-in-out focus:outline-none"
          role="switch"
          aria-label="Alternar tema">
          <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out translate-x-0 dark:translate-x-5"></span>
        </button>
      </div>
    </div>
  </header>
  <div class="shrink-0 flex items-center gap-2 my-4 overflow-x-auto pb-1">
    <span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mr-2">Filtrar:</span>
    <%= link_to "Todos", root_path, class: params[:project_type].blank? ? "filter-btn-active" : "filter-btn" %>
    <% @project_types.each do |key, value| %>
      <%= link_to key.titleize, root_path(project_type: value), class: params[:project_type].to_s == value.to_s ? "filter-btn-active" : "filter-btn" %>
    <% end %>
  </div>
  <div data-controller="kanban" class="kanban-board" data-action="dragover->kanban#autoScroll">
    <% @stages.each do |stage| %>
      <% stage_tasks = @tasks_by_stage[stage] || [] %>
      <section class="kanban-column <%= 'kanban-column-highlight' if stage == 'internal_review' %>">
        <header class="kanban-column-header">
          <h2 class="kanban-column-title">
            <%= stage.humanize.upcase %>
          </h2>
          <span data-kanban-target="count" data-stage="<%= stage %>" class="badge">
            <%= stage_tasks.size %>
          </span>
        </header>
        <div data-kanban-target="column"
             data-stage="<%= stage %>"
             data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
          class="kanban-column-body">
          <%= render stage_tasks %>
        </div>
      </section>
    <% end %>
  </div>
  <%= turbo_frame_tag "drawer" %>
</div>
