<%= turbo_frame_tag "drawer" do %>
  <div class="drawer-backdrop">
    <%= link_to "", root_path, data: { turbo_frame: "drawer" }, class: "fixed inset-0 cursor-default" %>

    <div class="drawer-panel">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-color mb-6 gap-2">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="badge <%= priority_badge_class(@task.priority) %>">
              <%= @task.priority.capitalize %>
            </span>
            <span class="badge <%= project_type_badge_class(@task.epic.project_type) %>">
              <%= @task.epic.project_type.upcase %>
            </span>
          </div>

          <div class="flex items-center gap-2">
            <% if policy(@task).edit? %>
              <%= link_to "Editar", edit_task_path(@task), data: { turbo_frame: "drawer" }, class: "btn-action cursor-pointer" %>
            <% end %>
            <% if policy(@task).destroy? %>
              <%= button_to "Excluir", task_path(@task), method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir esta tarefa?", turbo_frame: "_top" }, class: "btn-action-danger" %>
            <% end %>
            <%= link_to "✕", root_path, data: { turbo_frame: "drawer" }, class: "btn-action cursor-pointer text-gray-500 hover:text-gray-900 dark:hover:text-white" %>
          </div>
        </div>

        <h2 class="drawer-title">
          <%= @task.title %>
        </h2>

        <p class="drawer-subtitle">
          Épico: <strong><%= @task.epic.name %></strong> • Jira: <strong><%= @task.jira_key %></strong>
        </p>

        <div class="space-y-4">
          <div>
            <h4 class="drawer-section-title">Descrição</h4>
            <p class="drawer-description"><%= @task.description.presence || "Sem descrição informada." %></p>
          </div>
        </div>
      </div>

      <div class="pt-6 border-t border-color flex items-center justify-between mt-6">
        <% if @task.jira_url.present? %>
          <%= link_to "Abrir no Jira ↗", @task.jira_url, target: "_blank", rel: "noopener", class: "btn-action" %>
        <% end %>
        <% if @task.pull_request_url.present? %>
          <%= link_to "Ver Pull Request ↗", @task.pull_request_url, target: "_blank", rel: "noopener", class: "btn-action-pr" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>