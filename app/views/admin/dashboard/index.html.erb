<div class="w-full min-h-screen flex flex-col px-6 pt-6 pb-8 max-w-7xl mx-auto">
  <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-color mb-8 gap-4">
    <div>
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-xl md:text-2xl font-bold text-main tracking-tight">Painel Administrativo</h1>
        <span class="badge badge-accent">Admin Only</span>
      </div>
      <p class="text-xs md:text-sm text-muted mt-1">
        Visão geral das métricas do fluxo de trabalho e gerenciamento do sistema.
      </p>
    </div>

    <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
      <%= link_to "← Voltar ao Kanban", root_path, class: "btn-action cursor-pointer text-xs sm:text-sm py-2 px-3 shrink-0" %>
      <%= link_to "Gerenciar Usuários", admin_users_path, class: "btn-primary cursor-pointer text-xs sm:text-sm w-auto py-2 px-3.5 shrink-0" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-surface border border-color rounded-xl p-5 shadow-xs">
      <span class="text-xs font-semibold text-muted uppercase tracking-wider">Total de Tarefas</span>
      <p class="text-3xl font-extrabold text-main mt-2"><%= @total_tasks %></p>
      <span class="text-xs text-muted mt-1 block">no backlog geral</span>
    </div>

    <div class="bg-surface border border-color rounded-xl p-5 shadow-xs">
      <span class="text-xs font-semibold text-muted uppercase tracking-wider">Internal Reviews Ativos</span>
      <p class="text-3xl font-extrabold text-main mt-2"><%= @active_reviews_count %></p>
      <span class="text-xs text-muted mt-1 block">tarefas sendo analisadas</span>
    </div>

    <div class="bg-surface border border-color rounded-xl p-5 shadow-xs">
      <span class="text-xs font-semibold text-muted uppercase tracking-wider">Concluídas (Produção)</span>
      <p class="text-3xl font-extrabold text-main mt-2"><%= @completed_tasks_count %></p>
      <span class="text-xs text-muted mt-1 block">entregues com sucesso</span>
    </div>

    <div class="bg-surface border border-color rounded-xl p-5 shadow-xs">
      <span class="text-xs font-semibold text-muted uppercase tracking-wider">Usuários / Revisores</span>
      <p class="text-3xl font-extrabold text-main mt-2"><%= @total_users_count %></p>
      <span class="text-xs text-muted mt-1 block"><%= @reviewers_count %> ativos no fluxo</span>
    </div>
  </div>

  <div class="bg-surface border border-color rounded-xl p-6 shadow-xs">
    <h2 class="text-lg font-bold text-main mb-4">Tarefas Concluídas Recentemente</h2>
    <% if @recent_completed_tasks.any? %>
      <div class="divide-y divide-color">
        <% @recent_completed_tasks.each do |task| %>
          <div class="py-3 flex items-center justify-between">
            <div>
              <span class="text-xs font-mono text-muted mr-2">[<%= task.jira_key %>]</span>
              <strong class="text-sm text-main"><%= task.title %></strong>
              <span class="text-xs text-muted ml-2">• <%= task.epic.name %></span>
            </div>
            <div class="text-xs text-muted">
              Concluída em <%= task.updated_at.strftime("%d/%m/%Y às %H:%M") %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-muted">Nenhuma tarefa em produção ainda.</p>
    <% end %>
  </div>
</div>